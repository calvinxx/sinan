# 开发模式且所有 Supabase 配置为空时，自动进入内存演示模式。
# true：显式演示；false：强制使用真实 Supabase（配置不完整会提示）。
VITE_DEMO_MODE=false

# 三项均需配置。publishable key 本来就是浏览器公开配置。
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_ACCOUNT_EMAIL=

# 在 Supabase 开启 Turnstile 后填写公开 site key；secret key 只填 Supabase 管理端。
VITE_TURNSTILE_SITE_KEY=

# GitHub 仓库页面使用 /sinan/；自定义域名或根页面使用 /。
VITE_BASE_PATH=/
